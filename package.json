{
  "name": "score-view",
  "version": "1.0.0",
  "description": "Score View: a Bitwig Studio extension and web page that show the selected clip (or the whole arrangement) as music notation and edit it from the score.",
  "private": true,
  "scripts": {
    "postinstall": "node tools/fetch-api.mjs",
    "test": "bash test/run-all.sh all",
    "test:unit": "bash test/run-all.sh unit",
    "test:e2e": "bash test/run-all.sh e2e",
    "test:smoke": "bash test/run-all.sh smoke",
    "check:java": "node tools/check-java.mjs",
    "check:js": "node tools/check-js.mjs"
  },
  "keywords": [
    "bitwig",
    "notation",
    "score",
    "verovio"
  ],
  "author": "Joshua Devine",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "fflate": "^0.8.3",
    "verovio": "^4.5.1"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "puppeteer-core": "^23.11.1",
    "xmllint-wasm": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshuaJDevine/score-view"
  }
}
